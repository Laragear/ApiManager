<?php

namespace App\Http\Apis;

use Laragear\ApiManager\ApiServer;

class TestApi extends ApiServer
{
    /**
     * The headers to include in each request.
     *
     * @var array|array{string:string}
     */
    public $headers = [
        // 'X-Requested-With' => 'Laragear Api Manager'
    ];

    /**
     * The list of simple actions for this API.
     *
     * @var array|string[]
     */
    public $actions = [
        'latest' => '/',
        'create' => 'post:new',
    ];

    /**
     * Returns the API base URL.
     *
     * @return string
     */
    public function getBaseUrl()
    {
        return app()->isProduction()
            ? 'https://test-api.com/api/v1'
            : 'https://dev.test-api.com/api/v1';
    }

    /**
     * Returns the Bearer Token used for authentication.
     *
     * @return string|array
     */
    public function authToken()
    {
        return config('services.test-api.secret');
    }
}
